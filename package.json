{
  "name": "xodus-nexus-neo",
  "version": "0.3.9-neo.1",
  "description": "Apple Silicon Xbox Remote Play, Cloud Gaming and Microsoft Store launcher",
  "license": "MIT",
  "author": "Xodus Nexus Neo contributors; based on Xodus Nexus by domsvoboda",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && tsc -p tsconfig.electron.json && VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "clean": "node -e \"for (const p of ['dist','dist-electron']) require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:runtime-tools": "node --test scripts/eac-trace-summary.test.mjs scripts/wine-exception-metadata.test.mjs scripts/assemble-shared-runtime.test.mjs scripts/build-runtime-dxvk.test.mjs scripts/verify-runtime-base.test.mjs scripts/runtime-compat/staging.test.mjs scripts/runtime-tests/build-store-probes.test.mjs scripts/runtime-tests/build-user-privilege-probe.test.mjs",
    "test:ci-tools": "node --test scripts/ci/*.test.mjs",
    "build": "npm run clean && npm run typecheck && npm run test && vite build && tsc -p tsconfig.electron.json",
    "dist": "npm run build && electron-builder --linux AppImage --publish never",
    "pack": "npm run build && electron-builder --linux dir --publish never",
    "build:mac": "npm run build:controller:mac && npm run clean && npm run typecheck && npm run test:mac && vite build && tsc -p tsconfig.electron.json",
    "test:mac": "vitest run --config vitest.mac.config.ts",
    "pack:mac": "npm run build:mac && electron-builder --mac --arm64 --dir --publish never",
    "dist:mac": "npm run build:mac && electron-builder --mac --arm64 --publish never",
    "backend:mac": "node scripts/build-backend-macos.mjs",
    "build:controller:mac": "node scripts/build-controller-macos.mjs"
  },
  "dependencies": {
    "events": "3.3.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xbox-xcloud-player": "0.2.11"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.2",
    "electron": "44.8.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.northbridgetechnology.xodus-nexus-neo",
    "productName": "Xodus Nexus Neo",
    "artifactName": "Xodus-Nexus-Neo-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "!assets/fonts/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "assets/fonts",
        "to": "fonts"
      }
    ],
    "afterPack": "scripts/launcher-fonts-after-pack.cjs",
    "linux": {
      "category": "Game",
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ],
      "executableName": "xodus-nexus"
    },
    "mac": {
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "native-backend",
          "to": "backend"
        },
        {
          "from": "native-controller",
          "to": "controllers"
        }
      ],
      "icon": "assets/icon.png",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Xodus Nexus Neo connects to your Xbox on your home network for Remote Play video, audio and controller input."
      }
    }
  },
  "allowScripts": {
    "electron@44.8.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  },
  "homepage": "https://github.com/northbridgetechnology/xodus-nexus-neo",
  "repository": {
    "type": "git",
    "url": "https://github.com/northbridgetechnology/xodus-nexus-neo.git"
  },
  "bugs": {
    "url": "https://github.com/northbridgetechnology/xodus-nexus-neo/issues"
  }
}
